{
  "name": "dsh-prompt-forge",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.1 <0.3.0-0"
  },
  "description": "提示词锻造：输入框工具行挂一个 ✦ 入口，把口语化草稿改写成 agent 可执行的提示词（独有：验收补全 + 工作区文档感知 + 改写判定）",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "verify-host.mjs",
    "verify-client.mjs",
    "verify-live.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "license": "MIT",
  "author": "Gumife",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gumife/dsh-prompt-forge.git"
  },
  "homepage": "https://github.com/Gumife/dsh-prompt-forge#readme",
  "bugs": {
    "url": "https://github.com/Gumife/dsh-prompt-forge/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "prompt",
    "prompt-engineering",
    "llm",
    "ui"
  ]
}
